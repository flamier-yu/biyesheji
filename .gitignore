# ============================================================
# 云协同 PMS 版本控制忽略规则
# 目标：只提交源码与文档，不提交构建产物、依赖、运行数据与凭据
# ============================================================

# ---------------- 依赖与构建产物 ----------------
# node_modules 有 1.3 万个文件、约 170MB，绝不能提交
node_modules/
target/
dist/
build/
out/
*.jar
*.war
*.class
*.nar

# ---------------- 运行时数据 ----------------
logs/
*.log
uploads/
backups/
data/
*.pid

# ---------------- 环境配置（含凭据，禁止提交） ----------------
.env
.env.local
.env.*.local
application-local.yml
application-prod.yml

# ---------------- IDE ----------------
.idea/
.vscode/
*.iml
*.ipr
*.iws
.project
.classpath
.settings/
.factorypath

# ---------------- 操作系统 ----------------
.DS_Store
Thumbs.db
desktop.ini

# ---------------- 临时文件 ----------------
*.tmp
*.bak
*.swp
*~
~$*
.test.txt
.exec.txt
.build.txt
.npm.txt
.app.log
.web.log
