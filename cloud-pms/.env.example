# ============================================================
# 云协同 PMS 部署配置
# 用法：复制本文件为 .env 后按实际情况修改
#   cp .env.example .env
# ============================================================

# ------------------------------------------------------------
# 外部 MySQL 配置
# ------------------------------------------------------------
# DB_HOST 取值规则（重要）：
#   · MySQL 在宿主机（与 Docker 同一台机器）→ host.docker.internal
#     【推荐】这样容器能访问宿主机服务，跨 Windows/Mac/Linux 通用
#   · MySQL 在另一台服务器              → 直接填那台机器的内网 IP，如 192.168.1.20
#   · MySQL 在云端 RDS                  → 填 RDS 的外网/内网地址
DB_HOST=host.docker.internal
# DB_HOST=192.168.31.242

# 端口：MySQL 默认 3306，改过就填实际端口
DB_PORT=3306

# 库名：需与 sql/01-schema.sql 中建库语句一致
DB_NAME=biyesheji

# 账号密码：建议用专用账号（见 deploy/init-external-db.sql），不要用 root
# ⚠️ 变量名必须是 DB_USERNAME —— compose 读的是这个名字，写成 DB_USER 不生效（会静默回落成 root）
DB_USERNAME=pms
DB_PASSWORD=Pms@2026

# ------------------------------------------------------------
# Redis 配置（容器内运行）
# ------------------------------------------------------------
# 宿主机映射端口，仅监听 127.0.0.1
REDIS_PORT=6379
# 留空表示不设密码（容器内网访问，风险可控）
REDIS_PASSWORD=

# ------------------------------------------------------------
# 对外端口（宿主机侧；容器内固定为 后端 8080 / 前端 80，不用改）
# ------------------------------------------------------------
# 取值前先确认端口空闲：ss -lntp | grep 18080
# ⚠️ 1Panel 环境：面板自带的 OpenResty 通常已占用 80 与 8080，
#    务必避开这两个端口，否则报 "address already in use"
# 后端宿主机端口（仅供本机调试；前端 nginx 走容器内网反代后端，不依赖它）
BACKEND_PORT=18080
# 前端宿主机端口 —— 浏览器访问入口：http://<服务器IP>:9000
WEB_PORT=9000

# ⚠️ 改完端口必须重建容器才生效（restart 不会应用新的端口映射）：
#    docker compose up -d

# ------------------------------------------------------------
# JWT 密钥（生产环境必须修改）
# ------------------------------------------------------------
# 生成方式：openssl rand -base64 48
# 留空则使用 application.yml 中的默认值（仅建议开发环境）
JWT_SECRET=
